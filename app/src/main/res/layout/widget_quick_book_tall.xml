<?xml version="1.0" encoding="utf-8"?>
<!--
  快速预约小部件 · 高版（4x4 及以上）
  与标准版同一套控件 id，只是行高与字号放大，填满更高的格子。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_bg"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/widget_dot" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="珞珈座位"
                    android:textColor="@color/widget_title"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_status_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/widget_date_chip"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:paddingStart="7dp"
                    android:paddingTop="1.5dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="1.5dp"
                    android:singleLine="true"
                    android:text="已预约 09:00"
                    android:textColor="@color/widget_accent"
                    android:textSize="9.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/widget_date_chip"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:text="今天"
                android:textColor="@color/widget_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="3dp"
                android:contentDescription="刷新全馆余量"
                android:padding="3dp"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_building"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxWidth="96dp"
                android:singleLine="true"
                android:text="总馆"
                android:textColor="@color/widget_accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_stats_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="已约 1,358/3,200"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_stats_free"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="余 1,842"
                android:textColor="@color/widget_success"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_stats_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:maxHeight="5dp"
            android:minHeight="5dp"
            android:progress="0"
            android:progressDrawable="@drawable/widget_stats_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_seat_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_seat_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/widget_seat_name_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="001 号"
                    android:textColor="@color/widget_seat_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_seat_label_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="4F 北区"
                    android:textColor="@color/widget_muted"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_seat_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_seat_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/widget_seat_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="002 号"
                    android:textColor="@color/widget_seat_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_seat_label_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="4F 北区"
                    android:textColor="@color/widget_muted"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_seat_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_seat_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/widget_seat_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="003 号"
                    android:textColor="@color/widget_seat_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_seat_label_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="4F 北区"
                    android:textColor="@color/widget_muted"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_seat_spacer_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_seat_spacer_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_seat_spacer_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_seat_more"
                android:layout_width="20dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="…"
                android:textColor="@color/widget_muted"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_seat_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_seat_chip"
                android:gravity="center"
                android:text="还没有常用座位 · 点这里去收藏"
                android:textColor="@color/widget_muted"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_time_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="开始"
                    android:textColor="@color/widget_muted"
                    android:textSize="9.5sp" />

                <ImageView
                    android:id="@+id/widget_start_minus"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="开始时间减 30 分钟"
                    android:padding="4dp"
                    android:src="@drawable/ic_widget_minus" />

                <TextView
                    android:id="@+id/widget_start_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="08:00"
                    android:textColor="@color/widget_time_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_start_plus"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="开始时间加 30 分钟"
                    android:padding="4dp"
                    android:src="@drawable/ic_widget_plus" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_time_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="结束"
                    android:textColor="@color/widget_muted"
                    android:textSize="9.5sp" />

                <ImageView
                    android:id="@+id/widget_end_minus"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="结束时间减 30 分钟"
                    android:padding="4dp"
                    android:src="@drawable/ic_widget_minus" />

                <TextView
                    android:id="@+id/widget_end_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="12:00"
                    android:textColor="@color/widget_time_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_end_plus"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="结束时间加 30 分钟"
                    android:padding="4dp"
                    android:src="@drawable/ic_widget_plus" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_book"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/widget_btn"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:text="预约 001 号 · 08:00-12:00"
            android:textColor="@color/widget_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
