<?xml version="1.0" encoding="utf-8"?>
<!--
  快速预约小部件 · 紧凑版（3x3）
  3x3 实际内宽只有 ~148dp，因此：座位只显示号码、时间行用单字标签与更小的 ±，
  保证「起止时间」永远不会被挤掉。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_bg"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/widget_dot" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="珞珈座位"
                    android:textColor="@color/widget_title"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_status_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:background="@drawable/widget_date_chip"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="今天"
                android:textColor="@color/widget_accent"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="2dp"
                android:contentDescription="刷新全馆余量"
                android:padding="2dp"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="11dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_building"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxWidth="42dp"
                android:singleLine="true"
                android:text="总馆"
                android:textColor="@color/widget_accent"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_stats_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="已约 324/1,258"
                android:textColor="@color/widget_muted"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/widget_stats_free"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="余 934"
                android:textColor="@color/widget_success"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_stats_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:progress="0"
            android:progressDrawable="@drawable/widget_stats_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_seat_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_seat_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    android:id="@+id/widget_seat_name_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="011"
                    android:textColor="@color/widget_seat_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_seat_label_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="4F 座位区"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_seat_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_seat_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    android:id="@+id/widget_seat_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="015"
                    android:textColor="@color/widget_seat_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_seat_label_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="4F 座位区"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_seat_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_seat_chip"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    android:id="@+id/widget_seat_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="022"
                    android:textColor="@color/widget_seat_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_seat_label_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="4F 座位区"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_seat_spacer_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_seat_spacer_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_seat_spacer_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_seat_more"
                android:layout_width="14dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="…"
                android:textColor="@color/widget_muted"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_seat_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_seat_chip"
                android:gravity="center"
                android:text="还没有常用座位 · 点这里去收藏"
                android:textColor="@color/widget_muted"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 起止时间：单字标签 + 小号 ±，保证时间文本有足够宽度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_time_box"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="9dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="起"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/widget_start_minus"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="开始时间减 30 分钟"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_minus" />

                <TextView
                    android:id="@+id/widget_start_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="16:20"
                    android:textColor="@color/widget_time_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_start_plus"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="开始时间加 30 分钟"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_plus" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/widget_time_box"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="9dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="止"
                    android:textColor="@color/widget_muted"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/widget_end_minus"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="结束时间减 30 分钟"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_minus" />

                <TextView
                    android:id="@+id/widget_end_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="20:30"
                    android:textColor="@color/widget_time_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/widget_end_plus"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="结束时间加 30 分钟"
                    android:padding="2dp"
                    android:src="@drawable/ic_widget_plus" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_book"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_btn"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:text="现在预约 015 号"
            android:textColor="@color/widget_on_accent"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
